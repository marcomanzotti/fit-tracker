# Production environment. Copy to the server as .env and fill in.
# Postgres connection string (the embedded pglite:// database is refused in production).
DATABASE_URL=postgres://fit:CHANGE_ME@db:5432/fit
# At least 32 random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the site, must be https, e.g. https://example.com
BETTER_AUTH_URL=
# Transactional mail provider (EU), e.g. smtp://user:password@smtp.provider.eu:587
SMTP_URL=
